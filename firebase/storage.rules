rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Narrações publicadas são públicas (cache longo). Fotos de relatos só por URL assinada da API.
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
