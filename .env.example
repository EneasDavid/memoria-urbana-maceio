# Variáveis do login (Vercel → Settings → Environment Variables, ou .env.local para rodar no computador).
# NUNCA coloque valores reais aqui: este arquivo é público. Os valores ficam só na Vercel e no seu .env.local.

# Login com Google pelo Firebase Authentication (docs/firebase.md).
# Projeto do Firebase (padrão: memoria-urbana-maceio).
FIREBASE_PROJECT_ID=memoria-urbana-maceio
# Firebase → Configurações do projeto → Seus apps → site → apiKey. Identificador público, restrito aos domínios do site.
FIREBASE_WEB_API_KEY=cole-a-chave-web-do-firebase
# Firestore sem chave na Vercel (OIDC → conta de serviço). Não são segredos.
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/503211513071/locations/global/workloadIdentityPools/vercel/providers/vercel
GCP_SERVICE_ACCOUNT=api-progresso@memoria-urbana-maceio.iam.gserviceaccount.com
# Assina o cookie de sessão. Gere com: openssl rand -base64 48 (32+ caracteres).
SESSION_SECRET=troque-por-um-valor-aleatorio-de-32-ou-mais-caracteres
# E-mails (separados por vírgula) que entram como gestor e abrem /painel.
GESTOR_EMAILS=gestor@exemplo.com
